{
  "name": "umcp-local",
  "version": "0.1.0",
  "description": "Local MCP browser, game interface inspection and HTTP/WebSocket measurement",
  "type": "module",
  "engines": { "node": ">=22" },
  "bin": { "umcp": "src/index.js" },
  "scripts": {
    "start": "node src/index.js",
    "test": "node --test --test-isolation=none test/*.test.js",
    "test:unit": "node --test --test-isolation=none test/network.test.js test/ui.test.js test/image.test.js",
    "test:integration": "node --test --test-isolation=none test/integration.test.js test/mcp.test.js",
    "test:live": "node scripts/live-smoke.js",
    "check": "node scripts/check.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "playwright": "1.64.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": { "ws": "8.22.0" }
}
